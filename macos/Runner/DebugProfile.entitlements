<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Was present before; kept for the local stream server. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Without this, outbound peer/tracker/API connections fail
	     even in Debug/Profile, which is why it's easy to miss in day-to-day dev
	     if you were testing against cached/local content only. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>